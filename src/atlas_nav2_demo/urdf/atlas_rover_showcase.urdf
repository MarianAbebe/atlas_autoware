<?xml version="1.0"?>
<!-- Visualization-only Atlas concept. Dimensions are simulation placeholders. -->
<robot name="atlas_ackermann_showcase">
  <material name="atlas_blue"><color rgba="0.05 0.20 0.42 1"/></material>
  <material name="safety_orange"><color rgba="1.0 0.30 0.02 1"/></material>
  <material name="rubber"><color rgba="0.03 0.03 0.03 1"/></material>
  <link name="base_link"><visual><origin xyz="0 0 0.28"/><geometry><box size="1.65 0.92 0.30"/></geometry><material name="atlas_blue"/></visual><visual><origin xyz="-0.18 0 0.52"/><geometry><box size="0.82 0.78 0.20"/></geometry><material name="atlas_blue"/></visual></link>
  <link name="showcase_lidar_link"><visual><origin xyz="0 0 0.10"/><geometry><cylinder radius="0.12" length="0.20"/></geometry><material name="safety_orange"/></visual></link>
  <joint name="showcase_lidar_mount" type="fixed"><parent link="base_link"/><child link="showcase_lidar_link"/><origin xyz="0.12 0 0.57"/></joint>
  <link name="showcase_camera_front_link"><visual><geometry><box size="0.16 0.12 0.10"/></geometry><material name="rubber"/></visual></link>
  <joint name="showcase_camera_front_mount" type="fixed"><parent link="base_link"/><child link="showcase_camera_front_link"/><origin xyz="0.76 0 0.48"/></joint>
  <link name="showcase_imu_link"><visual><geometry><box size="0.08 0.08 0.04"/></geometry><material name="safety_orange"/></visual></link>
  <joint name="showcase_imu_mount" type="fixed"><parent link="base_link"/><child link="showcase_imu_link"/><origin xyz="0 0 0.48"/></joint>
  <link name="front_left_steer_link"/><link name="front_right_steer_link"/>
  <joint name="front_left_steering_joint" type="revolute"><parent link="base_link"/><child link="front_left_steer_link"/><origin xyz="0.60 0.52 0.20"/><axis xyz="0 0 1"/><limit lower="-0.5" upper="0.5" effort="1" velocity="1"/></joint>
  <joint name="front_right_steering_joint" type="revolute"><parent link="base_link"/><child link="front_right_steer_link"/><origin xyz="0.60 -0.52 0.20"/><axis xyz="0 0 1"/><limit lower="-0.5" upper="0.5" effort="1" velocity="1"/></joint>
  <link name="front_left_wheel_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.22" length="0.15"/></geometry><material name="rubber"/></visual></link>
  <link name="front_right_wheel_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.22" length="0.15"/></geometry><material name="rubber"/></visual></link>
  <link name="rear_left_wheel_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.22" length="0.15"/></geometry><material name="rubber"/></visual></link>
  <link name="rear_right_wheel_link"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.22" length="0.15"/></geometry><material name="rubber"/></visual></link>
  <joint name="front_left_wheel_joint" type="continuous"><parent link="front_left_steer_link"/><child link="front_left_wheel_link"/><origin xyz="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="front_right_wheel_joint" type="continuous"><parent link="front_right_steer_link"/><child link="front_right_wheel_link"/><origin xyz="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel_link"/><origin xyz="-0.60 0.52 0.20"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_right_wheel_link"/><origin xyz="-0.60 -0.52 0.20"/><axis xyz="0 1 0"/></joint>
</robot>
