# UTM/ARM64 handoff view. Expensive MarkerArray, PointCloud2, TF-tree, and
# RobotModel plugins are intentionally omitted. Add /atlas_loc/clusters as a
# PointCloud2 display manually only after this core view is responsive.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Local grid
      Enabled: true
      Alpha: 0.35
      Cell Size: 2
      Color: 120; 120; 125
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: map
    - Class: rviz_default_plugins/Path
      Name: Campus route
      Enabled: true
      Buffer Length: 1
      Color: 100; 140; 255
      Head Diameter: 0.3
      Head Length: 0.2
      Line Style: Lines
      Line Width: 0.08
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Pose Style: None
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /atlas_loc/route_path
    - Class: rviz_default_plugins/Path
      Name: Planned trajectory
      Enabled: true
      Buffer Length: 1
      Color: 0; 255; 100
      Head Diameter: 0.3
      Head Length: 0.2
      Line Style: Lines
      Line Width: 0.12
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Style: None
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /atlas_loc/trajectory_visualization
    - Class: rviz_default_plugins/Odometry
      Name: EKF estimated pose
      Enabled: true
      Angle Tolerance: 0.05
      Keep: 1
      Position Tolerance: 0.05
      Shape:
        Alpha: 1
        Color: 255; 170; 0
        Head Length: 0.4
        Head Radius: 0.25
        Shaft Length: 1.2
        Shaft Radius: 0.08
        Value: Arrow
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /atlas_loc/ekf/ekf_odom
    - Class: rviz_default_plugins/Axes
      Name: Estimated base_link axes
      Enabled: true
      Length: 1.5
      Radius: 0.08
      Reference Frame: base_link
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Focal Point:
        X: 49
        Y: 69
        Z: 0
      Name: Current View
      Near Clip Distance: 0.1
      Pitch: 0.8
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 1.57
    Saved: ~
Window Geometry:
  Height: 700
  Width: 1000
