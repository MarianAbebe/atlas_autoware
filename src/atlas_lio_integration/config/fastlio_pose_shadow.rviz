# Standalone FAST-LIO2 visualization only. Keep it in its own ROS domain and
# use odom as the fixed frame; this view does not imply EKF fusion or map TF.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: odom grid
      Enabled: true
      Cell Size: 2
      Plane Cell Count: 40
      Reference Frame: odom
    - Class: rviz_default_plugins/Pose
      Name: FAST-LIO2 pose-only shadow output
      Enabled: true
      Shape: Arrow
      Color: 255; 80; 220
      Topic:
        Value: /atlas/lio/shadow/pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: FAST-LIO2 TF (isolated domain)
      Enabled: false
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: odom
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.1
      Pitch: 0.8
      Target Frame: odom
      Yaw: 1.57
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
